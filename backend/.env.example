# Copy to .env and fill in. Local dev works with the defaults even without
# this file; PRODUCTION REFUSES TO START unless the marked values are set.

# ---------------------------------------------------------------- environment
# Set to "production" on the real server. This turns on the start-up safety
# checks (strong secret, media encryption key, no wildcard CORS, no SQLite)
# and enables HSTS.
ENVIRONMENT=development

# ------------------------------------------------------------------- database
# Remote MySQL (recommended for your setup):
#   DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
#   With TLS: append ?ssl_ca=/etc/ssl/certs/ca-certificates.crt
# Postgres example:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/usmlewise
# Local dev default (SQLite) — rejected in production:
DATABASE_URL=sqlite:///./usmlewise.db

# ---------------------------------------------------------------- JWT signing
# REQUIRED IN PRODUCTION. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please
ALGORITHM=HS256

# Collector sessions are long because field work happens offline for days.
# The device enforces an inactivity lock instead (IDLE_LOCK_MINUTES), which is
# how the automatic-logoff safeguard is met.
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Admin sessions reach every participant's data, so they are short.
ADMIN_TOKEN_EXPIRE_MINUTES=60
IDLE_LOCK_MINUTES=15

# ------------------------------------------------------- media encryption key
# REQUIRED IN PRODUCTION. Encrypts medical-record photographs and scanned
# screening sheets at rest with AES-256-GCM. Generate with:
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
# or:  python manage.py generate-media-key
#
# BACK THIS UP SEPARATELY FROM THE MEDIA VOLUME. Lose it and every stored
# photograph becomes permanently unreadable. That property is also the secure
# disposal mechanism — destroying the key crypto-shreds the images.
MEDIA_ENCRYPTION_KEY=

# ------------------------------------------------------ brute-force + policy
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=10

# ----------------------------------------------------------------------- MFA
# Require a TOTP second factor on administrator accounts. Leave this on.
REQUIRE_ADMIN_MFA=true
MFA_ISSUER=CRIST Tool

# ---------------------------------------------------------------------- CORS
# Leave EMPTY unless a separately hosted front end needs API access — the
# admin dashboard is served from this same origin. A "*" is rejected in
# production. Comma-separated, e.g.:
#   ALLOWED_ORIGINS=https://dashboard.example.org
ALLOWED_ORIGINS=

# --------------------------------------------------------------------- audit
# Six years is the HIPAA §164.316(b)(2)(i) minimum. The purge job refuses to
# run with a shorter window.
AUDIT_RETENTION_DAYS=2190

# --------------------------------------------------------------------- media
# MEDIA_DIR=/var/lib/crist/media
